    "DayCareManText_GiveOddEgg": {
      "raw_lines": [
        "text \"I'm the DAY-CARE\"",
        "line \"MAN.\"",
        "para \"Do you know about\"",
        "line \"EGGS?\"",
        "para \"I was raising\"",
        "line \"#MON with my\"",
        "cont \"wife, you see.\"",
        "para \"We were shocked to\"",
        "line \"find an EGG!\"",
        "para \"How incredible is\"",
        "line \"that?\"",
        "para \"Well, wouldn't you\"",
        "line \"like this EGG?\"",
        "para \"Then fine, this is\"",
        "line \"yours to keep!\"",
        "done"
