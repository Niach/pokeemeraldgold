        "line \"a ninja!\"",
        "para \"My intricate style\"",
        "line \"will confound and\"",
        "cont \"destroy you!\"",
        "para \"Confusion, sleep,\"",
        "line \"poison\u2026\"",
        "para \"Prepare to be the\"",
        "line \"victim of my sin-\"",
        "cont \"ister technique!\"",
        "para \"Fwahahahaha!\"",
        "para \"#MON is not\"",
        "line \"merely about brute\"",
        "para \"force--you shall\"",
        "line \"see soon enough!\"",
        "done"
