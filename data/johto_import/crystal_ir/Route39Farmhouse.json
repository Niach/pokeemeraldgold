  "texts": {
    "FarmerMText_SickCow": {
      "raw_lines": [
        "text \"My MILTANK ain't\"",
        "line \"givin' me milk\"",
        "cont \"n'more.\"",
        "para \"This here FARM's\"",
        "line \"got famous milk.\"",
        "para \"Most everyone\"",
        "line \"wants a drink.\"",
        "para \"It'll give me lots\"",
        "line \"o' milk if'n I\"",
