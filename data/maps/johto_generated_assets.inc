@ Route34 <= Route34
Crystal_Route34_YoungsterSamuelSeenText:
	.string "This is where I do\nmy training!$"

Crystal_Route34_YoungsterSamuelBeatenText:
	.string "Beaten by a\npassing stranger!$"

Crystal_Route34_YoungsterSamuelMobileText:
	.string "Have you been to\nGOLDENROD CITY?\pWeren't you amazed\nby how they've\pchanged the\nPOKéMON CENTER?$"

Crystal_Route34_YoungsterSamuelAfterText:
	.string "I'm going to train\neven harder.\pAfter all, I'm\ntrying to become\na GYM LEADER.$"

Crystal_Route34_YoungsterIanSeenText:
	.string "I'm the best in my\nclass at POKéMON.$"

Crystal_Route34_YoungsterIanBeatenText:
	.string "No! There are bet-\nter trainers…$"

Crystal_Route34_YoungsterIanAfterText:
	.string "I'm trying hard so\nI can be the star\nin my class.$"

Crystal_Route34_CamperTodd1SeenText:
	.string "I'm confident in\nmy ability to\nraise POKéMON.\pWant to see?$"

Crystal_Route34_CamperTodd1BeatenText:
