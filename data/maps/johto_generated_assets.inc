Crystal_GoldenrodHappinessRater_GoldenrodHappinessRatingText_NotUsedToYou:
	.string "You should treat\nit better. It's\nnot used to you.$"

Crystal_GoldenrodHappinessRater_GoldenrodHappinessRatingText_LooksMean:
