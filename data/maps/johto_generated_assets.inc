@ Route44 <= Route44
Crystal_Route44_FisherWilton1SeenText:
	.string "Aack! You made me\nlose a POLIWAG!\pWhat are you going\nto do about it?$"

Crystal_Route44_FisherWilton1BeatenText:
	.string "Just forget about\nit.$"

