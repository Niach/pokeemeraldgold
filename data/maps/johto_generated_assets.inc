	walk_right
	walk_up
	walk_up
	step_end

Crystal_Route35NationalParkGate_Route35NationalParkGatePlayerEnterParkMovement:
	walk_up
	step_end

@ Route36 <= Route36
Crystal_Route36_UseSquirtbottleText:
	.string "It's a weird tree.\nUse SQUIRTBOTTLE?$"

Crystal_Route36_UsedSquirtbottleText:
	.string "{PLAYER} used the\nSQUIRTBOTTLE.$"

Crystal_Route36_SudowoodoAttackedText:
	.string "The weird tree\ndoesn't like the\nSQUIRTBOTTLE!\pThe weird tree\nattacked!$"

Crystal_Route36_FloriaText1:
	.string "I'm the FLOWER\nSHOP's FLORIA!\pListen, listen!\pWhen I sprinkled\nwater on that\pwiggly tree, it\njumped right up!\pIt just has to be\na POKéMON.\pI bet it would be\nshocked out of its\pdisguise if you\nsoaked it!\pI know! I'll tell\nmy sis and borrow\nher water bottle!$"

Crystal_Route36_FloriaText2:
	.string "When I told my sis\nabout the jiggly\ptree, she said\nit's dangerous.\pIf I beat WHITNEY,\nI wonder if she'll\plend me her water\nbottle…$"

Crystal_Route36_RockSmashGuyText1:
	.string "Wa-hey!\pI was going to\nsnap that tree\pwith my straight-\narm punch.\pBut I couldn't!\nI'm a failure!$"

Crystal_Route36_RockSmashGuyText2:
	.string "Did you clear that\nwretched tree?\pI'm impressed!\nI want you to\nhave this.$"

Crystal_Route36_Text_ReceivedTM08:
	.string "{PLAYER} received\nTM08.$"

Crystal_Route36_RockSmashGuyText3:
	.string "That happens to be\nROCK SMASH.\pYou can shatter\nrocks with just a\psingle well-aimed\nsmack.\pIf any rocks are\nin your way, just\nsmash 'em up!$"

Crystal_Route36_UnusedOddTreeText:
	.string "An odd tree is\nblocking the way\nto GOLDENROD CITY.\pI wanted to go see\nthe huge POKéMON\pCENTER they just\nopened…$"

Crystal_Route36_Route36LassText:
	.string "An odd tree is\nblocking the way\nto GOLDENROD CITY.\pIt's preventing\nme from shopping.\pSomething should\nbe done about it.$"

Crystal_Route36_Route36LassText_ClearedSudowoodo:
	.string "That odd tree dis-\nappeared without a\ntrace.\pOh! That tree was\nreally a POKéMON?$"

Crystal_Route36_PsychicMarkSeenText:
	.string "I'm going to read\nyour thoughts!$"

Crystal_Route36_PsychicMarkBeatenText:
	.string "I misread you!$"

Crystal_Route36_PsychicMarkAfterBattleText:
	.string "I'd be strong if\nonly I could tell\pwhat my opponent\nwas thinking.$"

Crystal_Route36_SchoolboyAlan1SeenText:
	.string "Thanks to my stud-\nies, I'm ready for\nany POKéMON!$"

Crystal_Route36_SchoolboyAlan1BeatenText:
	.string "Oops! Computation\nerror?$"

Crystal_Route36_SchoolboyAlanBooksText:
	.string "Darn. I study five\nhours a day too.\pThere's more to\nlearning than just\nreading books.$"

Crystal_Route36_MeetArthurText:
	.string "ARTHUR: Who are\nyou?\pI'm ARTHUR of\nThursday.$"

Crystal_Route36_ArthurGivesGiftText:
	.string "Here. You can have\nthis.$"

Crystal_Route36_ArthurGaveGiftText:
	.string "ARTHUR: A POKéMON\nthat uses rock-\ptype moves should\nhold on to that.\pIt pumps up rock-\ntype attacks.$"

Crystal_Route36_ArthurThursdayText:
	.string "ARTHUR: I'm ARTHUR\nof Thursday. I'm\pthe second son out\nof seven children.$"

Crystal_Route36_ArthurNotThursdayText:
	.string "ARTHUR: Today's\nnot Thursday. How\ndisappointing.$"

Crystal_Route36_Route36SignText:
	.string "ROUTE 36$"

Crystal_Route36_RuinsOfAlphNorthSignText:
	.string "RUINS OF ALPH\nNORTH ENTRANCE$"

Crystal_Route36_Route36TrainerTips1Text:
	.string "TRAINER TIPS\pPOKéMON stats\nvary--even within\nthe same species.\pTheir stats may be\nsimilar at first.\pHowever, differ-\nences will become\ppronounced as the\nPOKéMON grow.$"

Crystal_Route36_Route36TrainerTips2Text:
	.string "TRAINER TIPS\pUse DIG to return\nto the entrance of\nany place.\pIt is convenient\nfor exploring\pcaves and other\nlandmarks.$"

