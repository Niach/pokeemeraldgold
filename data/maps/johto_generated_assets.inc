Crystal_RadioTower1F_RadioTower1FLuckyNumberManComeAgainText:
	.string "Please come back\nnext week for the\nnext LUCKY NUMBER.$"

Crystal_RadioTower1F_RadioTower1FLuckyNumberManPerfectMatchText:
	.string "Wow! You have a\nperfect match of\nall five numbers!\pWe have a grand\nprize winner!\pYou have won a\nMASTER BALL!$"

Crystal_RadioTower1F_RadioTower1FLuckyNumberManOkayMatchText:
