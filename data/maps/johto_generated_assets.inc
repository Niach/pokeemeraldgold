Crystal_GoldenrodHappinessRater_GoldenrodHappinessRaterTeacherText:
	.string "If you treat your\nPOKéMON nicely,\pthey will love you\nin return.\pOh? Let me see\nyour {STR_VAR_3}…$"

Crystal_GoldenrodHappinessRater_GoldenrodHappinessRatingText_LovesYouALot:
	.string "It looks really\nhappy! It must\nlove you a lot.$"

Crystal_GoldenrodHappinessRater_GoldenrodHappinessRatingText_ReallyTrustsYou:
	.string "I get the feeling\nthat it really\ntrusts you.$"

Crystal_GoldenrodHappinessRater_GoldenrodHappinessRatingText_SortOfHappy:
