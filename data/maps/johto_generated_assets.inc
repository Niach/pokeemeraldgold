@ Route27 <= Route27
Crystal_Route27_Route27FisherHeyText:
	.string "Hey!$"

Crystal_Route27_Route27FisherText:
	.string "Do you know what\nyou just did?\pYou've taken your\nfirst step into\nKANTO.\pCheck your POKé-\nGEAR MAP and see.$"

Crystal_Route27_CooltrainermBlakeSeenText:
	.string "You look pretty\nstrong.\nLet me battle you!$"

Crystal_Route27_CooltrainermBlakeBeatenText:
	.string "Yow!$"

