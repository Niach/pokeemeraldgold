@ OlivineCafe <= OlivineCafe
Crystal_OlivineCafe_OlivineCafeStrengthSailorText:
	.string "Hah! Your POKéMON\nsure look like\nlightweights!\pThey don't have\nthe power to move\nboulders aside.\pHere, use this\nand teach them\nSTRENGTH!$"

Crystal_OlivineCafe_OlivineCafeStrengthSailorText_GotStrength:
