JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript::
	turnobject LOCALID_OLIVINEPORT_SAILOR3, DIR_EAST
	checkevent EVENT_TEMPORARY_UNTIL_MAP_RELOAD_1
	iftrue JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_skip
	checkevent EVENT_TEMPORARY_UNTIL_MAP_RELOAD_2
	iftrue JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_skip
	turnobject LOCALID_PLAYER, DIR_WEST
	opentext
	checkevent EVENT_FAST_SHIP_FIRST_TIME
	iffalse JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_FirstTime
	special GetJohtoWeekday
	ifequal SUNDAY, JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_NextShipMonday
	ifequal SATURDAY, JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_NextShipMonday
	ifequal TUESDAY, JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_NextShipFriday
	ifequal WEDNESDAY, JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_NextShipFriday
	ifequal THURSDAY, JohtoScript_OlivinePort_OlivinePortWalkUpToShipScript_NextShipFriday

