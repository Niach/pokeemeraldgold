JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript::
	faceplayer
	opentext
	checkevent EVENT_TEMPORARY_UNTIL_MAP_RELOAD_1
	iftrue JohtoScript_OlivinePort_OlivinePortAlreadyRodeScript
	checkevent EVENT_FAST_SHIP_FIRST_TIME
	iffalse JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_FirstTime
	special GetJohtoWeekday
	ifequal SUNDAY, JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_NextShipMonday
	ifequal SATURDAY, JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_NextShipMonday
	ifequal TUESDAY, JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_NextShipFriday
	ifequal WEDNESDAY, JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_NextShipFriday
	ifequal THURSDAY, JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_NextShipFriday

