JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_FirstTime::
	writetext Crystal_OlivinePort_OlivinePortAskBoardText
	yesorno
	iffalse JohtoScript_OlivinePort_OlivinePortNotRidingScript
	writetext Crystal_OlivinePort_OlivinePortAskTicketText
	promptbutton
	checkitem ITEM_SS_TICKET
	iffalse JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_NoTicket
	writetext Crystal_OlivinePort_OlivinePortFlashTicketText
	waitbutton
	closetext
	setevent EVENT_TEMPORARY_UNTIL_MAP_RELOAD_2
	readvar VAR_FACING
	ifequal DIR_EAST, JohtoScript_OlivinePort_OlivinePortSailorAfterHOFScript_Right
	applymovement LOCALID_PLAYER, Crystal_OlivinePort_OlivinePortApproachFastShipAfterHOFMovement
	goto JohtoScript_OlivinePort_OlivinePortSailorAtGangwayScript

