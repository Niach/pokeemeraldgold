JohtoScript_Route32_FriedaScript::
	faceplayer
	opentext
	checkevent EVENT_GOT_POISON_BARB_FROM_FRIEDA
	iftrue JohtoScript_Route32_FriedaScript_Friday
	special GetJohtoWeekday
	ifnotequal FRIDAY, JohtoScript_Route32_FriedaScript_NotFriday
	checkevent EVENT_MET_FRIEDA_OF_FRIDAY
	iftrue JohtoScript_Route32_FriedaScript_MetFrieda
	writetext Crystal_Route32_MeetFriedaText
	promptbutton
	setevent EVENT_MET_FRIEDA_OF_FRIDAY

JohtoScript_Route32_FriedaScript_Friday::
	writetext Crystal_Route32_FriedaFridayText
	waitbutton

JohtoScript_Route32_FriedaScript_Done::
	closetext
	end

JohtoScript_Route32_FriedaScript_MetFrieda::
	writetext Crystal_Route32_FriedaGivesGiftText
	promptbutton
	verbosegiveitem ITEM_POISON_BARB
	iffalse JohtoScript_Route32_FriedaScript_Done
	setevent EVENT_GOT_POISON_BARB_FROM_FRIEDA
	writetext Crystal_Route32_FriedaGaveGiftText
	waitbutton
	closetext
	end

JohtoScript_Route32_FriedaScript_NotFriday::
	writetext Crystal_Route32_FriedaNotFridayText
	waitbutton
	closetext
	end

JohtoScript_Route32_Route32CooltrainerMScript::
	faceplayer

JohtoScript_Route32_Route32CooltrainerMContinueScene::
	opentext
	checkevent EVENT_GOT_MIRACLE_SEED_IN_ROUTE_32
	iftrue JohtoScript_Route32_Route32CooltrainerMContinueScene_GotMiracleSeed
	checkflag ENGINE_ZEPHYRBADGE
	iffalse JohtoScript_Route32_Route32CooltrainerMContinueScene_DontHaveZephyrBadge
	checkevent EVENT_GOT_TOGEPI_EGG_FROM_ELMS_AIDE
	iftrue JohtoScript_Route32_Route32CooltrainerMContinueScene_GiveMiracleSeed
	writetext Crystal_Route32_Route32CooltrainerMText_AideIsWaiting
	waitbutton
	closetext
	end

JohtoScript_Route32_Route32CooltrainerMContinueScene_DontHaveZephyrBadge::
	writetext Crystal_Route32_Route32CooltrainerMText_VioletGym
	waitbutton
	closetext
	end

JohtoScript_Route32_Route32CooltrainerMContinueScene_GiveMiracleSeed::
	writetext Crystal_Route32_Route32CooltrainerMText_HaveThisSeed
	promptbutton
	verbosegiveitem ITEM_MIRACLE_SEED
	iffalse JohtoScript_Route32_Route32CooltrainerMContinueScene_BagFull
	setevent EVENT_GOT_MIRACLE_SEED_IN_ROUTE_32
	goto JohtoScript_Route32_Route32CooltrainerMContinueScene_GotMiracleSeed

JohtoScript_Route32_Route32CooltrainerMContinueScene_BagFull::
