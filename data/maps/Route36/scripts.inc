JohtoScript_Route36_ArthurScript::
	faceplayer
	opentext
	checkevent EVENT_GOT_HARD_STONE_FROM_ARTHUR
	iftrue JohtoScript_Route36_ArthurScript_AlreadyGotStone
	special GetJohtoWeekday
	ifnotequal THURSDAY, JohtoScript_Route36_ArthurNotThursdayScript
	checkevent EVENT_MET_ARTHUR_OF_THURSDAY
	iftrue JohtoScript_Route36_ArthurScript_MetArthur
	writetext Crystal_Route36_MeetArthurText
	promptbutton
	setevent EVENT_MET_ARTHUR_OF_THURSDAY

