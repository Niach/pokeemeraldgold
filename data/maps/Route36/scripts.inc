JohtoScript_Route36_Route36FloriaScript::
	faceplayer
	opentext
	checkevent EVENT_TALKED_TO_FLORIA_AT_FLOWER_SHOP
	iftrue JohtoScript_Route36_Route36FloriaScript_SecondTimeTalking
	setevent EVENT_MET_FLORIA
	writetext Crystal_Route36_FloriaText1
	waitbutton
	closetext
	clearevent EVENT_FLORIA_AT_FLOWER_SHOP
	readvar VAR_FACING
	ifequal DIR_NORTH, JohtoScript_Route36_Route36FloriaScript_Up
	applymovement LOCALID_ROUTE36_FLORIA, Crystal_Route36_FloriaMovement1
	disappear LOCALID_ROUTE36_FLORIA
	end

JohtoScript_Route36_Route36FloriaScript_SecondTimeTalking::
	writetext Crystal_Route36_FloriaText2
	waitbutton
	closetext
	end

JohtoScript_Route36_Route36FloriaScript_Up::
	applymovement LOCALID_ROUTE36_FLORIA, Crystal_Route36_FloriaMovement2
	disappear LOCALID_ROUTE36_FLORIA
	end

