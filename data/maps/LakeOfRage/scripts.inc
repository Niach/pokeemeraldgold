JohtoScript_LakeOfRage_WesleyScript::
	faceplayer
	opentext
	checkevent EVENT_GOT_BLACKBELT_FROM_WESLEY
	iftrue JohtoScript_LakeOfRage_WesleyWednesdayScript
	special GetJohtoWeekday
	ifnotequal WEDNESDAY, JohtoScript_LakeOfRage_WesleyNotWednesdayScript
	checkevent EVENT_MET_WESLEY_OF_WEDNESDAY
	iftrue JohtoScript_LakeOfRage_WesleyScript_MetWesley
	writetext Crystal_LakeOfRage_MeetWesleyText
	promptbutton
	setevent EVENT_MET_WESLEY_OF_WEDNESDAY

