JohtoScript_BlackthornCity_SantosScript::
	faceplayer
	opentext
	checkevent EVENT_GOT_SPELL_TAG_FROM_SANTOS
	iftrue JohtoScript_BlackthornCity_SantosScript_Saturday
	special GetJohtoWeekday
	ifnotequal SATURDAY, JohtoScript_BlackthornCity_SantosScript_NotSaturday
	checkevent EVENT_MET_SANTOS_OF_SATURDAY
	iftrue JohtoScript_BlackthornCity_SantosScript_MetSantos
	writetext Crystal_BlackthornCity_MeetSantosText
	promptbutton
	setevent EVENT_MET_SANTOS_OF_SATURDAY

JohtoScript_BlackthornCity_SantosScript_MetSantos::
	writetext Crystal_BlackthornCity_SantosGivesGiftText
	promptbutton
	verbosegiveitem ITEM_SPELL_TAG
	iffalse JohtoScript_BlackthornCity_SantosScript_Done
	setevent EVENT_GOT_SPELL_TAG_FROM_SANTOS
	writetext Crystal_BlackthornCity_SantosGaveGiftText
	waitbutton
	closetext
	end

