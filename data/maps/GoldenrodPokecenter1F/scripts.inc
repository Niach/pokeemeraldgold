JohtoScript_GoldenrodPokecenter1F_GoldenrodPokecenter1F_GSBallSceneLeft::
	lockall
	goto_if_ne VAR_JOHTO_GOLDENROD_SCENE_STATE, 0, JohtoScript_GoldenrodPokecenter1F_GoldenrodPokecenter1F_GSBallSceneLeft_End
	playsound SE_EXIT
	moveobject LOCALID_GOLDENRODPOKECENTER1F_PCC_TRADE_CORNER_RECEPTIONIST, 0, 7
	disappear LOCALID_GOLDENRODPOKECENTER1F_PCC_TRADE_CORNER_RECEPTIONIST
	appear LOCALID_GOLDENRODPOKECENTER1F_PCC_TRADE_CORNER_RECEPTIONIST
	applymovement LOCALID_GOLDENRODPOKECENTER1F_PCC_TRADE_CORNER_RECEPTIONIST, Crystal_GoldenrodPokecenter1F_GoldenrodPokeCenter1FLinkReceptionistApproachPlayerAtLeftDoorwayTileMovement
	waitmovement 0
	turnobject LOCALID_PLAYER, DIR_NORTH
	msgbox Crystal_GoldenrodPokecenter1F_GoldenrodPokecomCenterWelcomeToTradeCornerText, MSGBOX_DEFAULT
	setvar VAR_JOHTO_GOLDENROD_SCENE_STATE, 1
	applymovement LOCALID_GOLDENRODPOKECENTER1F_PCC_TRADE_CORNER_RECEPTIONIST, Crystal_GoldenrodPokecenter1F_GoldenrodPokeCenter1FLinkReceptionistWalkToStairsFromLeftDoorwayTileMovement
	waitmovement 0
	disappear LOCALID_GOLDENRODPOKECENTER1F_PCC_TRADE_CORNER_RECEPTIONIST
	playsound SE_EXIT
	waitsfx
JohtoScript_GoldenrodPokecenter1F_GoldenrodPokecenter1F_GSBallSceneLeft_End:
	releaseall
	end

